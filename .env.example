# Copy this file to .env.local. Never commit .env.local.

# API key for https://api.meta.ai/v1. Leave empty to stay in mock mode.
MODEL_API_KEY=

# Set to true to force mock data even when MODEL_API_KEY is set.
# If the key is missing, the app uses mock data anyway.
USE_MOCK=true

# Hard cap on estimated live-model spend, in US dollars. Blank means 100.
# Mock calls cost $0 and do not count toward this.
BUDGET_LIMIT_USD=100

# Passcode required before any live model call. Checked only on the server.
# If this is empty, live mode is off and every visitor gets mock data.
# Do not put the code in client code or commit it.
LIVE_ACCESS_CODE=

# How many live analysis runs the whole server may start per hour. Blank means 10.
# Mock demo runs do not count.
LIVE_RUNS_PER_HOUR=10

# Input caps (fixed in code, listed here so they are easy to find):
# - at most 20 ad images per run
# - at most 5 MB per image
# - at most 5 concept briefs and 5 mockups per run
