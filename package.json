{
  "name": "creative-intelligence-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:mock": "tsx scripts/validate-mock.ts",
    "check:budget": "tsx --tsconfig scripts/tsconfig.budget.json scripts/validate-budget.ts",
    "check:safety": "tsx --tsconfig scripts/tsconfig.budget.json scripts/validate-safety.ts",
    "check:crop": "tsx scripts/validate-crop.ts",
    "check:text": "tsx scripts/validate-place-text.ts",
    "check:gaps": "tsx scripts/validate-gaps.ts",
    "check:phone": "tsx --tsconfig scripts/tsconfig.budget.json scripts/validate-phone.ts",
    "check:layout": "tsx scripts/validate-layout.ts && tsx --tsconfig scripts/tsconfig.budget.json scripts/validate-phone.ts",
    "m2:smoke": "tsx --tsconfig scripts/tsconfig.budget.json scripts/m2-smoke.ts",
    "m3:candidates": "tsx --tsconfig scripts/tsconfig.budget.json scripts/m3-candidates.ts",
    "m3:lock": "tsx --tsconfig scripts/tsconfig.budget.json scripts/m3-lock.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@meta-sam/parser": "^0.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "openai": "^7.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
